{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(composer check)",
      "Bash(composer test)",
      "Bash(composer test *)",
      "Bash(composer test:unit)",
      "Bash(composer test:unit *)",
      "Bash(composer stan)",
      "Bash(composer stan *)",
      "Bash(composer cs)",
      "Bash(composer cs:fix)",
      "Bash(composer cs:fix *)",
      "Bash(composer rector)",
      "Bash(composer rector *)",
      "Bash(composer infection)",
      "Bash(composer infection *)",
      "Bash(composer install)",
      "Bash(composer dump-autoload)",
      "Bash(composer validate *)",
      "Bash(vendor/bin/phpunit *)",
      "Bash(vendor/bin/phpstan *)",
      "Bash(vendor/bin/php-cs-fixer *)",
      "Bash(vendor/bin/rector *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ],
    "ask": [
      "Bash(composer require *)",
      "Bash(composer remove *)",
      "Bash(composer update *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(composer test:integration *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-php.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
