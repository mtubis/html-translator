{
    "name": "mtubis/html-translator",
    "description": "Translate HTML with LLMs (OpenAI, Anthropic, Gemini, Ollama, …) while preserving markup, semantics and document validity.",
    "type": "library",
    "license": "MIT",
    "keywords": ["html", "translation", "i18n", "l10n", "llm", "openai", "anthropic", "ollama", "ai"],
    "authors": [
        {
            "name": "Magdalena Tubis"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "psr/cache": "^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0"
    },
    "suggest": {
        "phpunit/phpunit": "To run Provider\\Llm\\Testing\\ChatModelContractTestCase against your own chat model adapter"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35.6",
        "nyholm/psr7": "^1.8.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7",
        "symfony/http-client": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "HtmlTranslator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HtmlTranslator\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --group integration",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "infection": "infection --threads=max --show-mutations",
        "fixtures:update": "php scripts/update-fixtures.php",
        "check": [
            "@cs",
            "@rector",
            "@stan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "check": "Run everything CI runs: code style, rector dry-run, PHPStan and tests.",
        "fixtures:update": "Regenerate expected.pseudo.html of golden fixtures (all, or the names after --). Review the result by hand.",
        "test:integration": "Run the tests against real model APIs (load .env first, see .env.dist)."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
