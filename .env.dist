# Copy to .env (git-ignored) and fill in what you want to run. Nothing here is read automatically:
# load it into your shell first, e.g.  set -a; . ./.env; set +a; composer test:integration
# A provider is skipped while its first variable is empty. Never commit real keys.

# OpenAI
HTML_TRANSLATOR_OPENAI_API_KEY=
HTML_TRANSLATOR_OPENAI_MODEL=gpt-4o-mini

# Gemini (OpenAI-compatible endpoint)
HTML_TRANSLATOR_GEMINI_API_KEY=
HTML_TRANSLATOR_GEMINI_MODEL=gemini-2.5-flash

# Ollama (e.g. after `ollama pull llama3.1`)
HTML_TRANSLATOR_OLLAMA_MODEL=
HTML_TRANSLATOR_OLLAMA_BASE_URL=http://localhost:11434/v1

# vLLM
HTML_TRANSLATOR_VLLM_MODEL=
HTML_TRANSLATOR_VLLM_BASE_URL=http://localhost:8000/v1
HTML_TRANSLATOR_VLLM_API_KEY=

# LM Studio
HTML_TRANSLATOR_LMSTUDIO_MODEL=
HTML_TRANSLATOR_LMSTUDIO_BASE_URL=http://localhost:1234/v1
